                "value": "{{database}}",
                "type": "text",
                "disabled": true
              },
              {
                "key": "User-Agent",
                "value": "postman-odoo-json2-client",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/res.users/context_get",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "res.users",
                "context_get"
              ]
